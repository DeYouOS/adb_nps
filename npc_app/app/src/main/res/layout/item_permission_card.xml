<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_marginBottom="12dp"
    android:elevation="1dp"
    android:padding="16dp">

    <!-- Title row: title + status badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_perm_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A" />

        <TextView
            android:id="@+id/tv_perm_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- Purpose line -->
    <TextView
        android:id="@+id/tv_perm_purpose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#666666"
        android:layout_marginTop="4dp" />

    <!-- Button row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_go_settings"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="去设置"
            android:textSize="14sp"
            android:minWidth="80dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <Button
            android:id="@+id/btn_autostart_confirm"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="我已设置好"
            android:textSize="14sp"
            android:minWidth="96dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_toggle_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查看步骤 ▼"
            android:textSize="13sp"
            android:textColor="#1976D2"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Collapsible steps area (hidden by default) -->
    <LinearLayout
        android:id="@+id/ll_steps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="10dp"
        android:padding="12dp"
        android:background="#F5F5F5">

        <TextView
            android:id="@+id/tv_menu_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:text="菜单路径：" />

        <TextView
            android:id="@+id/tv_steps_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#444444"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

</LinearLayout>
